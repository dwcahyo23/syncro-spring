+-- ============================================================================
+-- V11: PM execution audit entity types (story 19-5, blueprint F7/F8).
+-- Additive-only migration: extends the ck_audit_log_entity_type CHECK with
+-- PM_EXECUTION and PM_EXECUTION_ITEM that AuditEntityType.PM_EXECUTION /
+-- AuditEntityType.PM_EXECUTION_ITEM write (the doc comment on that enum
+-- requires the Java enum and the SQL CHECK to move together in one change —
+-- V6..V10 drop-and-recreate pattern, preserving every prior value).
+-- No schema changes to pm_executions / pm_execution_items — both tables
+-- already carry every F7/F8 column in V1.
+-- ============================================================================
+
+ALTER TABLE audit_log
+  DROP CONSTRAINT ck_audit_log_entity_type;
+
+ALTER TABLE audit_log
+  ADD CONSTRAINT ck_audit_log_entity_type CHECK (entity_type IN
+    ('PLANT', 'MACHINE_GROUP', 'MACHINE', 'SPAREPART_TAXONOMY',
+     'SPAREPART', 'INSTALLATION', 'RESPONSIBILITY', 'ALERT',
+     'SPAREPART_PRICE_ENTRY', 'SECTION', 'TEAM', 'WORK_ORDER_CATEGORY',
+     'WORK_ORDER', 'REPAIR_SESSION', 'WORKORDER_ATTACHMENT',
