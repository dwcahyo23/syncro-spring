+  /** entity_label is VARCHAR(255) NOT NULL — parameterText (≤500) is truncated. */
+  private static String itemLabel(PmChecklistItemEntity entity) {
+    var text = entity.getParameterText();
+    return text.length() <= 255 ? text : text.substring(0, 255);
+  }
