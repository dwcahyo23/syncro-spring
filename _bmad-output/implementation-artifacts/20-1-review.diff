+    when(targets.saveAndFlush(any())).thenAnswer(inv -> inv.getArgument(0));
+
+    // Only the breakdown target changes; everything else stays.
+    var view = service.upsert(admin, new TargetCommand(plantId, AUG, 7, null, null, null, null));
