diff --git a/syncro/apps/backend/src/main/java/com/syncro/maintenance/infrastructure/db/KpiSourceDataJpaAdapter.java b/syncro/apps/backend/src/main/java/com/syncro/maintenance/infrastructure/db/KpiSourceDataJpaAdapter.java
