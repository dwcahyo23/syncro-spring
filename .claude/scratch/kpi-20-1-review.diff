+    statusHistory.saveAndFlush(new com.syncro.maintenance.infrastructure.db
+        .WorkOrderStatusHistoryEntity(UUID.randomUUID(), wo2.getId(), null, "PENDING_REVIEW",
+        "MANUAL", technician.getId().toString(), "trace-2",
