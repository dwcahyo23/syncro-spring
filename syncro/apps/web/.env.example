TEST_ENV=local

# Web base URL. Required by Playwright tests (browser navigation and web server).
BASE_URL=http://localhost:3001

# Backend base URL. Required by Playwright API tests; includes the /api/v1 base path.
API_URL=http://localhost:8080/api/v1

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Optional override for the Playwright web server command.
# Default is `npm run dev -- -p <port from BASE_URL>`; uncomment only when a custom start command is needed.
# PLAYWRIGHT_WEB_SERVER_COMMAND=npm run dev -- -p 3001
