# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=syncro
POSTGRES_USER=syncro
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# pgAdmin (local/dev only)
PGADMIN_EMAIL=admin@syncro.dev
PGADMIN_PASSWORD=CHANGE_ME_strong_password
PGADMIN_PORT=5050

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# InfluxDB 3 Core (no username/org/bucket — InfluxDB 3 uses token-only auth)
# Generate token with: docker run --rm influxdb:3-core sh -c "influxdb3 create token --admin --offline --output-file /tmp/t && cat /tmp/t"
# Copy the "token" field value (starts with apiv3_)
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8181
INFLUXDB_TOKEN=CHANGE_ME_apiv3_generate_with_influxdb3_create_token
INFLUXDB_DATABASE=syncro

# EMQX MQTT
SYNCRO_MQTT_HOST=localhost
SYNCRO_MQTT_PORT=1883
SYNCRO_MQTT_DASHBOARD_PORT=18083
SYNCRO_MQTT_USERNAME=syncro_backend
SYNCRO_MQTT_PASSWORD=CHANGE_ME_strong_password
SYNCRO_MQTT_CLIENT_ID=syncro-backend-1
SYNCRO_MQTT_TOPIC_FILTER=factory/+/+/telemetry

# WAHA
WAHA_HOST=localhost
WAHA_PORT=3000
WAHA_API_KEY=CHANGE_ME_strong_api_key

# OPA (Open Policy Agent authorization sidecar)
OPA_HOST=localhost
# Host port must differ from the InfluxDB port when running the backend on the host
OPA_PORT=18181

# Garage (S3-compatible object storage; local/dev only)
# GARAGE_HOST must resolve wherever presigned GET URLs will be opened — typically the
# browser, not just the backend JVM. For phone/device testing use your LAN IP, not localhost.
# Generate the RPC secret with: openssl rand -hex 32
# (PowerShell CSPRNG equivalent:
#   $b=[byte[]]::new(32); [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);
#   ($b | ForEach-Object { $_.ToString('x2') }) -join '' )
GARAGE_HOST=localhost
GARAGE_S3_PORT=3900
GARAGE_RPC_SECRET=CHANGE_ME_64_char_hex_random_secret
GARAGE_ADMIN_TOKEN=CHANGE_ME_random_admin_token
GARAGE_ACCESS_KEY=syncro-garage-dev
GARAGE_SECRET_KEY=CHANGE_ME_strong_secret_key
GARAGE_BUCKET=syncro-spareparts
# Must match s3_region in syncro/infra/garage/garage.toml — changing it here alone makes
# every SigV4 signature fail server-side.
GARAGE_REGION=garage
GARAGE_PRESIGN_TTL_SECONDS=300

# Backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SYNCRO_AUTH_JWT_SECRET=CHANGE_ME_min_32_chars_random_secret_key
SYNCRO_AUTH_JWT_ISSUER=syncro-local
SYNCRO_AUTH_JWT_TTL_MINUTES=480
SYNCRO_AUTH_LOCAL_ADMIN_ENABLED=true
SYNCRO_AUTH_LOCAL_ADMIN_LOGIN=admin@syncro.dev
SYNCRO_AUTH_LOCAL_ADMIN_PASSWORD=CHANGE_ME_strong_password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Authz coarse gate (9.5 rolls out enforcement on the org/maintenance/sync surface;
# 18-x adds the inventory surface; 19-1 adds the PM frequencies/checksheets surface; 19-2 adds the PM checklist surface;
# 19-3 adds the PM schedules/schedule-dates surface; 19-4 adds the PM work-orders surface;
# 19-5 adds the PM executions surface; 19-6 adds the PM execution print-report path;
# 21-1 adds the non-conformances/8D compliance surface;
# 22-2 adds the auth login-audit reads and phone-challenge surface;
# health/actuator stay public and are deliberately excluded)
SYNCRO_AUTHZ_ENFORCED_PATHS=/api/v1/plants/**,/api/v1/machine-groups/**,/api/v1/sections/**,/api/v1/teams/**,/api/v1/machine-responsibilities/**,/api/v1/machines/**,/api/v1/machine-sparepart-installations/**,/api/v1/spareparts/**,/api/v1/sparepart-taxonomies/**,/api/v1/alerts/**,/api/v1/audit-log/**,/api/v1/setup-completeness/**,/api/v1/telemetry/**,/api/v1/notification/templates/**,/api/v1/notification/worker/**,/api/v1/work-order-categories/**,/api/v1/workorders/**,/api/v1/workorders/*/transition,/api/v1/workorders/*/sessions,/api/v1/workorders/*/sessions/stop,/api/v1/workorders/*/attachments,/api/v1/workorders/*/attachments/*,/api/v1/workorders/*/report,/api/v1/workorders/*/report/cpk,/api/v1/workorders/*/todos,/api/v1/workorders/*/todos/*,/api/v1/workorders/*/todos/*/assign,/api/v1/workorders/*/todos/*/complete,/api/v1/workorders/*/todos/*/reorder,/api/v1/workorders/*/ratings,/api/v1/workorders/*/ratings/technician,/api/v1/workorders/*/ratings/workorder,/api/v1/rating-dimensions,/api/v1/rating-dimensions/*,/api/v1/preventive-programs,/api/v1/preventive-programs/*,/api/v1/preventive-programs/*/generate,/api/v1/preventive-schedules,/api/v1/preventive-schedules/*/checklist,/api/v1/preventive-schedules/*/evidence,/api/v1/preventive-schedules/*/evidence/*,/api/v1/preventive-schedules/*/approve,/api/v1/preventive-schedules/*/skip,/api/v1/sparepart-requests,/api/v1/sparepart-requests/*/transition,/api/v1/sparepart-requests/*/mre,/api/v1/sparepart-requests/*/approve,/api/v1/sparepart-requests/*/complete,/api/v1/sparepart-stock,/api/v1/sparepart-stock/*,/api/v1/sparepart-stock/*/adjust,/api/v1/departments,/api/v1/departments/*,/api/v1/departments/*/members,/api/v1/sections/*/leader,/api/v1/auth/users/*,/api/v1/sync/**,/api/v1/inventory-locations/**,/api/v1/inventory-locations/*/stock-balances,/api/v1/inventory-locations/*/stock-balances/*,/api/v1/inventory-locations/*/stock-balances/*/adjust,/api/v1/inventory-transfers,/api/v1/inventory-transfers/*,/api/v1/inventory-transfers/*/approve,/api/v1/inventory-transfers/*/reject,/api/v1/pm-frequencies/**,/api/v1/pm-checksheets/**,/api/v1/pm-checklist-categories/**,/api/v1/pm-checklist-items/**,/api/v1/pm-schedules/**,/api/v1/pm-schedules/*/submit,/api/v1/pm-schedules/*/approve-spv,/api/v1/pm-schedules/*/approve-prod,/api/v1/pm-schedules/*/activate,/api/v1/pm-schedules/*/dates/*/transition,/api/v1/pm-work-orders,/api/v1/pm-work-orders/*,/api/v1/pm-work-orders/generate,/api/v1/pm-work-orders/sweep-overdue,/api/v1/pm-work-orders/*/assign,/api/v1/pm-work-orders/*/start,/api/v1/pm-work-orders/*/complete,/api/v1/pm-executions,/api/v1/pm-executions/*,/api/v1/pm-executions/start,/api/v1/pm-executions/*/items/*/fill,/api/v1/pm-executions/*/complete,/api/v1/pm-executions/*/verify,/api/v1/pm-executions/*/report,/api/v1/non-conformances/**,/api/v1/non-conformances,/api/v1/non-conformances/*,/api/v1/non-conformances/*/eight-d,/api/v1/non-conformances/*/eight-d/verify-effectiveness,/api/v1/auth/login-audits,/api/v1/auth/login-audits/*,/api/v1/auth/phone-challenges,/api/v1/auth/phone-challenges/*,/api/v1/auth/phone-challenges/*/verify,/api/v1/auth/phone-challenges/*/resend
SYNCRO_AUTHZ_DEGRADED_ALLOWLIST=/api/v1/health,/actuator/**

# Authz decision-log retention (days) for the authz_decisions purge job
SYNCRO_AUTHZ_DECISION_LOG_RETENTION_DAYS=30
SYNCRO_AUTHZ_POLICY_FILE=file:syncro/authz/policy/authz.rego

# Sparepart request escalation worker poll interval (story 12-3, FR-147)
SYNCRO_SPAREPART_ESCALATION_POLL_INTERVAL_MS=60000

# External Sync Pipeline (story 13-1, AD-7/FR-150/FR-151)
# Disabled by default — enable to connect the external PostgreSQL.
# SYNCRO_SYNC_ENABLED=true
# SYNCRO_SYNC_DATASOURCE_URL=jdbc:postgresql://external-host:5432/external_db
# SYNCRO_SYNC_DATASOURCE_USERNAME=external_user
# SYNCRO_SYNC_DATASOURCE_PASSWORD=CHANGE_ME_strong_password
# SYNCRO_SYNC_BATCH_SIZE=100
# SYNCRO_SYNC_POLL_INTERVAL_MS=60000
# SYNCRO_SYNC_LOCK_TTL_MS=900000
# Fallback category code when an external category code is unmapped (story 13-2, OQ-4);
# empty = skip unmapped categories as before.
# SYNCRO_SYNC_FALLBACK_CATEGORY_CODE=01
