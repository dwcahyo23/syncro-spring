# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=syncro
POSTGRES_USER=syncro
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# pgAdmin (local/dev only)
PGADMIN_EMAIL=admin@syncro.dev
PGADMIN_PASSWORD=CHANGE_ME_strong_password
PGADMIN_PORT=5050

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# InfluxDB 3 Core (no username/org/bucket — InfluxDB 3 uses token-only auth)
# Generate token with: docker run --rm influxdb:3-core sh -c "influxdb3 create token --admin --offline --output-file /tmp/t && cat /tmp/t"
# Copy the "token" field value (starts with apiv3_)
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8181
INFLUXDB_TOKEN=CHANGE_ME_apiv3_generate_with_influxdb3_create_token
INFLUXDB_DATABASE=syncro

# EMQX MQTT
SYNCRO_MQTT_HOST=localhost
SYNCRO_MQTT_PORT=1883
SYNCRO_MQTT_DASHBOARD_PORT=18083
SYNCRO_MQTT_USERNAME=syncro_backend
SYNCRO_MQTT_PASSWORD=CHANGE_ME_strong_password
SYNCRO_MQTT_CLIENT_ID=syncro-backend-1
SYNCRO_MQTT_TOPIC_FILTER=factory/+/+/telemetry

# WAHA
WAHA_HOST=localhost
WAHA_PORT=3000
WAHA_API_KEY=CHANGE_ME_strong_api_key

# OPA (Open Policy Agent authorization sidecar)
OPA_HOST=localhost
# Host port must differ from the InfluxDB port when running the backend on the host
OPA_PORT=18181

# Garage (S3-compatible object storage; local/dev only)
# GARAGE_HOST must resolve wherever presigned GET URLs will be opened — typically the
# browser, not just the backend JVM. For phone/device testing use your LAN IP, not localhost.
# Generate the RPC secret with: openssl rand -hex 32
# (PowerShell CSPRNG equivalent:
#   $b=[byte[]]::new(32); [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);
#   ($b | ForEach-Object { $_.ToString('x2') }) -join '' )
GARAGE_HOST=localhost
GARAGE_S3_PORT=3900
GARAGE_RPC_SECRET=CHANGE_ME_64_char_hex_random_secret
GARAGE_ADMIN_TOKEN=CHANGE_ME_random_admin_token
GARAGE_ACCESS_KEY=syncro-garage-dev
GARAGE_SECRET_KEY=CHANGE_ME_strong_secret_key
GARAGE_BUCKET=syncro-spareparts
# Must match s3_region in syncro/infra/garage/garage.toml — changing it here alone makes
# every SigV4 signature fail server-side.
GARAGE_REGION=garage
GARAGE_PRESIGN_TTL_SECONDS=300

# Backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SYNCRO_AUTH_JWT_SECRET=CHANGE_ME_min_32_chars_random_secret_key
SYNCRO_AUTH_JWT_ISSUER=syncro-local
SYNCRO_AUTH_JWT_TTL_MINUTES=480
SYNCRO_AUTH_LOCAL_ADMIN_ENABLED=true
SYNCRO_AUTH_LOCAL_ADMIN_LOGIN=admin@syncro.dev
SYNCRO_AUTH_LOCAL_ADMIN_PASSWORD=CHANGE_ME_strong_password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Authz coarse gate (9.5 rolls out enforcement on the org/maintenance/sync surface;
# health/actuator stay public and are deliberately excluded)
SYNCRO_AUTHZ_ENFORCED_PATHS=/api/v1/plants/**,/api/v1/machine-groups/**,/api/v1/sections/**,/api/v1/teams/**,/api/v1/machine-responsibilities/**,/api/v1/machines/**,/api/v1/machine-sparepart-installations/**,/api/v1/spareparts/**,/api/v1/sparepart-taxonomies/**,/api/v1/alerts/**,/api/v1/audit-log/**,/api/v1/setup-completeness/**,/api/v1/telemetry/**,/api/v1/notification/templates/**,/api/v1/notification/worker/**,/api/v1/work-order-categories/**
SYNCRO_AUTHZ_DEGRADED_ALLOWLIST=/api/v1/health,/actuator/**

# Authz decision-log retention (days) for the authz_decisions purge job
SYNCRO_AUTHZ_DECISION_LOG_RETENTION_DAYS=30
SYNCRO_AUTHZ_POLICY_FILE=file:syncro/authz/policy/authz.rego
