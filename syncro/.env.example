# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=syncro
POSTGRES_USER=syncro
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# pgAdmin (local/dev only)
PGADMIN_EMAIL=admin@syncro.dev
PGADMIN_PASSWORD=CHANGE_ME_strong_password
PGADMIN_PORT=5050

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# InfluxDB 3 Core (no username/org/bucket — InfluxDB 3 uses token-only auth)
# Generate token with: docker run --rm influxdb:3-core sh -c "influxdb3 create token --admin --offline --output-file /tmp/t && cat /tmp/t"
# Copy the "token" field value (starts with apiv3_)
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8181
INFLUXDB_TOKEN=CHANGE_ME_apiv3_generate_with_influxdb3_create_token
INFLUXDB_DATABASE=syncro

# EMQX MQTT
SYNCRO_MQTT_HOST=localhost
SYNCRO_MQTT_PORT=1883
SYNCRO_MQTT_DASHBOARD_PORT=18083
SYNCRO_MQTT_USERNAME=syncro_backend
SYNCRO_MQTT_PASSWORD=CHANGE_ME_strong_password
SYNCRO_MQTT_CLIENT_ID=syncro-backend-1
SYNCRO_MQTT_TOPIC_FILTER=factory/+/+/telemetry

# WAHA
WAHA_HOST=localhost
WAHA_PORT=3000
WAHA_API_KEY=CHANGE_ME_strong_api_key

# Backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SYNCRO_AUTH_JWT_SECRET=CHANGE_ME_min_32_chars_random_secret_key
SYNCRO_AUTH_JWT_ISSUER=syncro-local
SYNCRO_AUTH_JWT_TTL_MINUTES=480
SYNCRO_AUTH_LOCAL_ADMIN_ENABLED=true
SYNCRO_AUTH_LOCAL_ADMIN_LOGIN=admin@syncro.dev
SYNCRO_AUTH_LOCAL_ADMIN_PASSWORD=CHANGE_ME_strong_password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
