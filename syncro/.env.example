# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=syncro
POSTGRES_USER=syncro
POSTGRES_PASSWORD=syncro_dev

# pgAdmin (local/dev only)
PGADMIN_EMAIL=admin@syncro.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# InfluxDB
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=syncro
INFLUXDB_PASSWORD=syncro_dev_password
INFLUXDB_TOKEN=syncro-dev-token
INFLUXDB_ORG=syncro
INFLUXDB_BUCKET=syncro_telemetry

# EMQX MQTT
SYNCRO_MQTT_HOST=localhost
SYNCRO_MQTT_PORT=1883
SYNCRO_MQTT_DASHBOARD_PORT=18083
SYNCRO_MQTT_USERNAME=syncro_backend
SYNCRO_MQTT_PASSWORD=syncro_mqtt_dev
SYNCRO_MQTT_CLIENT_ID=syncro-backend-1
SYNCRO_MQTT_TOPIC_FILTER=factory/+/+/telemetry

# WAHA
WAHA_HOST=localhost
WAHA_PORT=3000
WAHA_API_KEY=syncro-waha-dev-key

# Backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SYNCRO_AUTH_JWT_SECRET=syncro-local-jwt-secret-change-before-shared-use
SYNCRO_AUTH_JWT_ISSUER=syncro-local
SYNCRO_AUTH_JWT_TTL_MINUTES=480
SYNCRO_AUTH_LOCAL_ADMIN_ENABLED=true
SYNCRO_AUTH_LOCAL_ADMIN_LOGIN=admin@syncro.dev
SYNCRO_AUTH_LOCAL_ADMIN_PASSWORD=syncro-admin-dev

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
